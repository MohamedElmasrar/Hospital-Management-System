{
  "folders": [
    {
      "name": "Project (Root)",
      "path": "."
    },
    {
      "name": "API Gateway",
      "path": "api-gateway"
    },
    {
      "name": "Auth Service",
      "path": "auth-service"
    },
    {
      "name": "Billing Service",
      "path": "billing-service"
    },
    {
      "name": "HR Service",
      "path": "hr-service"
    },
    {
      "name": "Reception Service",
      "path": "reception-service"
    },
    {
      "name": "Analytics Service",
      "path": "analytics-service"
    },
    {
      "name": "Frontend",
      "path": "frontend"
    }
  ],
  "settings": {
    "java.compile.nullAnalysis.mode": "disabled",
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.debug.settings.onBuildFailureProceed": true,
    "java.autobuild.enabled": false,
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-21",
        "path": "/usr/lib/jvm/java-21-openjdk-amd64",
        "default": true
      }
    ],
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
    "java.jdt.ls.lombokSupport.enabled": true,
    "java.jdt.ls.vmargs": "-XX:+UseG1GC -XX:+UseStringDeduplication -Xmx3G -Xms512m",
    "java.server.launchMode": "Standard",
    "java.project.importOnFirstTimeStartup": "automatic",
    "java.import.gradle.enabled": true,
    "java.import.gradle.wrapper.enabled": true,
    "java.import.gradle.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
    "java.import.gradle.annotationProcessing.enabled": true,
    "java.import.exclusions": [
      "**/node_modules/**",
      "**/.metadata/**",
      "**/archetype/**",
      "frontend/**",
      "**/build/**",
      "**/.gradle/**",
      "**/.git/**",
      "**/.sts4-cache/**"
    ],
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/*/**": true,
      "**/frontend/node_modules/**": true,
      "**/frontend/.next/**": true,
      "**/.gradle/**": true,
      "**/build/**": true,
      "**/.sts4-cache/**": true,
      "**/.metadata/**": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/.gradle": true,
      "**/.sts4-cache": true,
      "**/.factorypath": true,
      "**/.apt_generated": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/build": true,
      "**/.gradle": true,
      "**/frontend/.next": true,
      "**/.sts4-cache": true
    },
    "gradle.nestedProjects": true,
    "gradle.autoDetect": "off",
    "boot-java.ls.includeClassPathMetadata": true,
    "boot-java.rewrite.reconcile": false,
    "boot-java.symbols.include-all-symbols": false,
    "eslint.enable": true,
    "eslint.workingDirectories": [
      { "mode": "auto" },
      "./frontend"
    ],
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "typescript.suggest.completeFunctionCalls": true,
    "javascript.suggest.completeFunctionCalls": true
  }
}
